# Copy to `.env` for local dev. NEVER commit the real .env (it is gitignored).
# On Railway these are injected automatically — do not hardcode them anywhere.

# Postgres connection string. Railway provides this via the Postgres plugin.
DATABASE_URL=postgres://user:password@localhost:5432/miworld

# HTTP/WebSocket port. Railway sets PORT automatically; 8080 for local dev.
PORT=8080
